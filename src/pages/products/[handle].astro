---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import SeoHead from "@components/SeoHead.astro";
import { shopifyFetch } from "@lib/shopify";
import {
  GET_PRODUCT_BY_HANDLE,
  GET_PRODUCT_HANDLES,
} from "@lib/queries/products.ts";

import ProductMediaGallery from "@components/Product/ProductMediaGallery.svelte";
import ProductPurchaseBlock from "@components/Product/ProductPurchaseBlock.svelte";
import ProductInfoBlock from "@components/Product/ProductInfoBlock.astro";
import SizeGuide from "@lib/components/SizeGuide.svelte";

export async function getStaticPaths() {
  const data = await shopifyFetch(GET_PRODUCT_HANDLES);
  const products = data.products;

  return products.map((product) => ({
    params: { handle: product.handle },
  }));
}

const { handle } = Astro.params;

const data = await shopifyFetch(GET_PRODUCT_BY_HANDLE, { handle });
const product = data.productByHandle;
---

<SeoHead
  title={`${product.title} | MALYXIA`}
  description={`Shop ${product.title}`}
/>

<DefaultLayout>
  <div class="relative z-10 min-h-screen pb-20">
    <div
      class="md:grid md:grid-cols-[1fr_320px] md:pl-10 lg:grid-cols-[1fr_500px] md:gap-12"
    >
      <!-- LEFT: MEDIA -->
      <div class="flex-1 min-w-0">
        <div class="block md:hidden">
          <ProductMediaGallery
            client:load
            variant="swipe"
            images={product.images}
          />
        </div>
        <div class="hidden md:block">
          <ProductMediaGallery
            client:load
            variant="editorial"
            images={product.images}
          />
        </div>
      </div>

      <!-- RIGHT: STICKY INFO -->
      <div class="relative flex flex-col">
        <div class="flex-1"></div>
        <div class="md:sticky md:bottom-1">
          <div class="space-y-8 p-5">
            <ProductInfoBlock product={product} />
            <ProductPurchaseBlock
              client:only="svelte"
              product={product}
              mode="detail"
            />
            <SizeGuide client:only="svelte" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ JSON-LD goes here -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      name: product.title,
      image: product.images?.edges?.[0]?.node?.url,
      description: product.description ?? "MALYXIA drop product",
      brand: {
        "@type": "Brand",
        name: "MALYXIA",
      },
      offers: {
        "@type": "Offer",
        priceCurrency: "USD",
        price: product.selectedOrFirstAvailableVariant?.price?.amount,
        availability: product.selectedOrFirstAvailableVariant?.availableForSale
          ? "https://schema.org/InStock"
          : "https://schema.org/OutOfStock",
        url: `https://malyxia.xyz/products/${product.handle}`,
      },
    })}
  />
</DefaultLayout>
