---
import TheLogo from "../components/TheLogo.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { shopifyFetch } from "../lib/shopify.ts";
import { GET_DROP_PRODUCT } from "../lib/queries/products.ts";

import BuyNow from "../components/Cart/BuyNow.svelte";
import SeoHead from "../components/SeoHead.astro";
import ProductMediaGallery from "../components/Product/ProductMediaGallery.svelte";
import ProductPurchaseBlock from "../components/Product/ProductPurchaseBlock.svelte";

const data = await shopifyFetch(GET_DROP_PRODUCT);
const product = data.products.nodes[0];

// normalized layer
// const bg = product.chapterBg?.reference?.image?.url ?? null;
const stock = product.dropStock?.value ?? "11/18";
---

<DefaultLayout>
  <SeoHead title="MALYXIA — Chapter 1" />

  <main class="relative flex flex-col md:h-screen">
    <div
      class="fixed top-0 left-0 right-0 md:hidden border-b border-black/10 bg-white/95 backdrop-blur-sm z-40"
    >
      <div
        class="flex items-center justify-between px-4 py-3 text-[10px] uppercase tracking-wider"
      >
        <div class="flex flex-col leading-none">
          <span>{product.title}</span>
          <span class="opacity-60">$55</span>
        </div>

        <BuyNow client:load product={product} />
      </div>
    </div>

    <section
      class="min-h-[100svh] md:min-h-0 md:flex-1 flex flex-col relative overflow-hidden pt-14 md:pt-0"
    >
      <div
        class="hidden md:grid w-full grid-cols-12 border-b border-black/10 z-10 text-[10px] uppercase tracking-[0.2em] opacity-60 flex-shrink-0"
      >
        <div class="p-4 md:col-span-3 border-r border-black/10">
          WE ARE NOT PERFECT
        </div>

        <div class="p-4 md:col-span-6 text-center">
          DROP_01 // {product.title}
        </div>

        <div class="p-4 md:col-span-3 text-right border-l border-black/10">
          READY TO SHIP
        </div>
      </div>

      <div
        class="w-full grid grid-cols-1 md:flex md:flex-1 items-stretch z-10 relative overflow-hidden"
      >
        <div
          class="hidden md:flex md:w-1/4 border-r border-black/10 p-6 flex-col justify-between text-xs"
        >
          <div class="space-y-4">
            <p class="uppercase opacity-60 text-[10px]">SPECIFICATIONS</p>

            <p class="text-[11px] leading-relaxed uppercase">
              - HEAVYWEIGHT STRUCTURED BUILD<br />
              - RELAXED BOXY FIT<br />
              - FADED BLACK WASH FINISH
            </p>
          </div>
        </div>

        <div
          class="w-full md:w-1/2 md:border-b-0 p-4 md:p-8 flex items-center justify-center bg-neutral-50/40 md:bg-transparent min-h-[32vh] md:min-h-0"
        >
          <div class="w-full md:max-w-lg mx-auto mix-blend-multiply">
            <ProductMediaGallery
              client:load
              images={product.images}
              altBase={product.title}
              productHandle={product.handle}
              variant="compact"
            />
          </div>
        </div>

        <div
          class="w-full md:w-1/4 p-6 flex flex-col justify-center items-stretch border-t md:border-t-0 border-black/10"
        >
          <div class="space-y-6 w-full">
            <div class="space-y-3">
              <div
                class="flex justify-between items-baseline border-b border-black/5 pb-2"
              >
                <a href={`/products/${product.handle}`}>
                  <h2 class="uppercase text-sm">{product.title}</h2>
                </a>

                <div class="text-[10px] uppercase opacity-60">
                  STOCK // {stock}
                </div>
              </div>
            </div>

            <ProductPurchaseBlock
              client:only="svelte"
              product={product}
              mode="quick"
            />

            <div class="text-[10px] uppercase opacity-60 space-y-1 pt-6">
              <p>EST. SHIPPING 2–5 DAYS</p>
              <p>TRACKED DELIVERY</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div
      class="hidden md:grid grid-cols-12 border-t border-black/10 text-[10px] uppercase opacity-60 flex-shrink-0"
    >
      <div class="p-4 col-span-3 border-r border-black/10">LO // ATLANTA</div>
      <div class="p-4 col-span-6 text-center">BORN WRONG</div>
      <div class="p-4 col-span-3 text-right border-l border-black/10">
        © 2026
      </div>
    </div>
  </main>

  <TheLogo />
</DefaultLayout>
